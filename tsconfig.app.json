{
  "compilerOptions": {
    "target":           "ES2020",
    "lib":              ["ES2020", "DOM", "DOM.Iterable"],
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "jsx":              "react-jsx",

    /* Strict */
    "strict":                        true,
    "noUnusedLocals":                true,
    "noUnusedParameters":            true,
    "noFallthroughCasesInSwitch":    true,

    /* Résolution */
    "resolveJsonModule":             true,
    "isolatedModules":               true,
    "moduleDetection":               "force",
    "skipLibCheck":                  true,

    /* Alias @/ → src/ (doit correspondre à vite.config.ts) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
