# .env.demo.example
# Path: .env.demo.example
# Variables pour le déploiement ou l'exécution du mode démo

# Active explicitement le mode démo
VITE_DEMO_MODE=true

# URL de votre vitrine Appalacarte pour le bouton de retour
VITE_APPALACARTE_URL=https://appalacarte.fr

# (Optionnel) Supabase dédié au mode démo avec tables demo_*
# Si absent, l'application utilise automatiquement le jeu de données d'exemple local
VITE_DEMO_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_DEMO_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
